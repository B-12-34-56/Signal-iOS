<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AWS_ACCESS_KEY_ID</key>
    <string>$(AWS_ACCESS_KEY_ID)</string>
    <key>AWS_SECRET_ACCESS_KEY</key>
    <string>$(AWS_SECRET_ACCESS_KEY)</string>
    <key>AWS_SESSION_TOKEN</key>
    <string>$(AWS_SESSION_TOKEN)</string>
    <key>AWS_REGION</key>
    <string>$(AWS_REGION)</string>
    <key>API_GATEWAY_ENDPOINT</key>
    <string>$(API_GATEWAY_ENDPOINT)</string>
    <key>API_GATEWAY_API_KEY</key>
    <string>$(API_GATEWAY_API_KEY)</string>
    <key>COGNITO_IDENTITY_POOL_ID</key>
    <string>$(COGNITO_IDENTITY_POOL_ID)</string>
    <key>S3_BUCKET_NAME</key>
    <string>$(S3_BUCKET_NAME)</string>
    <key>S3_IMAGES_PATH</key>
    <string>$(S3_IMAGES_PATH)</string>
    <key>DYNAMODB_TABLE_NAME</key>
    <string>$(DYNAMODB_TABLE_NAME)</string>
    <key>DYNAMODB_REGION</key>
    <string>$(DYNAMODB_REGION)</string>
    <key>AWSContentFilterBucket</key>
    <string>$(S3_BUCKET_NAME)</string>
    <key>AWSContentFilterFunction</key>
    <string>your-lambda-function-name</string>
    <key>AWSContentFilterRegion</key>
    <string>us-east-1</string>
    <key>AWSContentFilterPoolID</key>
    <string>$(COGNITO_IDENTITY_POOL_ID)</string>
    <key>AWSContentFilterTable</key>
    <string>$(DYNAMODB_TABLE_NAME)</string>
    <key>DuplicateThreshold</key>
    <integer>5</integer>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Required to attach images to messages.</string>
    <key>NSCameraUsageDescription</key>
    <string>Required to capture images for messages.</string>
</dict>
</plist> 