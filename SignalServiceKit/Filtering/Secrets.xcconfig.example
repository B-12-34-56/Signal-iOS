// AWS API Configuration
// Copy this file to Secrets.xcconfig and replace the values with your actual credentials
// DO NOT commit Secrets.xcconfig to source control

AWS_API_URL = https://your-api-endpoint.execute-api.region.amazonaws.com/stage/path
AWS_API_KEY = your-api-key-here
AWS_ACCESS_KEY_ID = your-access-key-id-here
AWS_SECRET_ACCESS_KEY = your-secret-access-key-here
AWS_SESSION_TOKEN = your-session-token-here
AWS_REGION = us-east-1 